#!/bin/sh
set -eu

scanner=$(git rev-parse --git-path tools/gitleaks)
if [ ! -x "$scanner" ]; then
  scanner=$(command -v gitleaks) || {
    echo 'Install Gitleaks before pushing this project.' >&2
    exit 1
  }
fi

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    *[!0]*) "$scanner" git --redact=100 --no-banner --log-opts="$local_oid" . ;;
  esac
done
